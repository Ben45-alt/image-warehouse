# ===== ตัวอย่างไฟล์ secrets (ไฟล์ต้นแบบ) =====
# วิธีใช้:
#   1. สร้างโฟลเดอร์ชื่อ  .streamlit
#   2. ก๊อปไฟล์นี้ไปไว้ในนั้น แล้วเปลี่ยนชื่อเป็น  secrets.toml
#   3. เติมค่าจริงลงไป (โดยเฉพาะ 3 ค่าใต้ [google_oauth] ที่ได้จาก get_refresh_token.py)
#
# ⚠️ สำคัญ: ห้าม commit ไฟล์ .streamlit/secrets.toml ขึ้น GitHub เด็ดขาด
#          (มี .gitignore กันไว้ให้แล้ว)

# รหัสผ่านสำหรับเข้าหน้าแอป (ตั้งเองได้ตามใจ)
APP_PASSWORD = "เปลี่ยนเป็นรหัสที่ต้องการ"

# ลิงก์ Google Sheet ที่ใช้เป็นฐานข้อมูล (ใส่ลิงก์ Sheet ของคุณ)
SHEET_URL = "https://docs.google.com/spreadsheets/d/xxxxxxxxxxxxxxxx/edit"

# Folder ID ของ Google Drive ที่ใช้เก็บรูป (ใส่ Folder ID ของคุณ)
DRIVE_FOLDER_ID = "xxxxxxxxxxxxxxxx"

# ===== ค่าจาก OAuth — ได้จากการรัน get_refresh_token.py =====
[google_oauth]
client_id = "xxxxxxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxxxxxxxxxx"
refresh_token = "1//xxxxxxxxxxxxxxxxxxxx"
